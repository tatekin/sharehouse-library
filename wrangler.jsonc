{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharehouse-library",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  // *.workers.dev の本番URLと、PRごとのプレビューURLを有効にする（既定値と同じ。警告を消すため明示）
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/* だけWorkerで処理し、それ以外は静的ファイルをそのまま返す
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sharehouse-library",
      "database_id": "8c32c043-1443-4310-a517-73dd9dba332c",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
